package: "com.android.icu"
container: "com.android.i18n"

flag {
    namespace: "core_libraries"
    name: "icu_v_api"
    is_exported: true
    description: "This flag controls whether exposing ICU 74 APIs and implementation"
    bug: "312171264"
    # ICU is used before SettingsProvider starts
    is_fixed_read_only: true
}

flag {
    namespace: "core_libraries"
    name: "icu_25q2_api"
    is_exported: true
    description: "This flag controls whether exposing new APIs in 25Q2"
    bug: "374966838"
    # ICU is used before SettingsProvider starts
    is_fixed_read_only: true
}

flag {
    namespace: "core_libraries"
    name: "telephony_lookup_mcc_extension"
    is_exported: true
    description: "This flag controls whether to parse the new MCC to countries mapping from telephony lookup"
    bug: "376493245"
    # ICU is used before SettingsProvider starts
    is_fixed_read_only: true
}

flag {
    namespace: "core_libraries"
    name: "icu_26q2_api"
    is_exported: true
    description: "This flag controls whether exposing new APIs in 26Q2"
    bug: "437414022"
    # ICU is used before SettingsProvider starts
    is_fixed_read_only: true
}

flag {
    namespace: "location"
    # namespace: "location" is used by the Android System Time team for feature flags.
    name: "enable_multi_country_override_parsing"
    description: "Enable parsing of multi-country overrides to fix b/414758970."
    bug: "414758970"
    is_fixed_read_only: true
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
